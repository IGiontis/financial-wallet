# Copy this file to `.env` and fill in the values from your own dashboards.
# `.env` is gitignored — never commit real keys.
#
#   Firebase → Project settings → General → Your apps → SDK setup and configuration
#   Exchange Rate API → https://www.exchangerate-api.com dashboard

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_EXCHANGE_RATE_API_KEY=
