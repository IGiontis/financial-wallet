    # Copy this file to `.env` and fill in the values from your own dashboards.
# `.env` is gitignored — never commit real keys.
#
#   Firebase → Project settings → General → Your apps → SDK setup and configuration
#   Exchange Rate API → https://www.exchangerate-api.com dashboard

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Google Analytics (Firebase → Project settings → General → Your apps → measurementId, "G-…"). Optional.
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3 site key — google.com/recaptcha/admin). Optional: absent, App Check is off.
VITE_APPCHECK_SITE_KEY=
# Optional, for `npm run dev` against the real project: a debug token registered under App Check → Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=

VITE_EXCHANGE_RATE_API_KEY=
